# Copy to .env and fill in. Never commit real secrets.

# Backend (FastAPI)
APP_ENV=development
DATABASE_URL=postgresql+asyncpg://campus:campus@localhost:5432/campus_support
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=change-me
ENFORCE_UNIVERSITY_EMAIL=false
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=14
# AES-GCM message encryption at rest. Generate with: openssl rand -base64 32
# Required in production; a random ephemeral key is used in development if unset.
FIELD_ENCRYPTION_KEY=
CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000"]
# Optional regex for localhost/LAN testing on any port; leave blank to use exact origins only.
CORS_ORIGIN_REGEX=

# Conversation model (Claude via Anthropic API, behind the LLM adapter)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
LLM_TIMEOUT_SECONDS=15

# Speech (ElevenLabs)
# The two named voices are used by voice_preference=auto: female students hear
# the MALE voice and male students hear the FEMALE voice. Users can override
# this with PATCH /auth/me/voice (auto | male | female).
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID_FEMALE=
ELEVENLABS_VOICE_ID_MALE=
# Optional calmer voice used for crisis replies, regardless of preference.
ELEVENLABS_CRISIS_VOICE_ID=
# ELEVENLABS_VOICE_ID is a legacy fallback when a named voice is unset.
ELEVENLABS_VOICE_ID=
MAX_AUDIO_BYTES=10485760

# Vector knowledge used to enrich Claude's context (pgvector on DATABASE_URL).
# Claude has no embeddings API: point this at any OpenAI-compatible /embeddings
# endpoint for semantic search; offline dev uses a deterministic local embedding.
EMBEDDING_API_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
# Must stay 384 to match the pgvector column in migration 0001.
EMBEDDING_DIMENSIONS=384
KNOWLEDGE_TOP_K=4

# MCP policy and tool server
# Backend connects here; the server binds MCP_SERVER_HOST/MCP_SERVER_PORT and serves /mcp.
MCP_SERVER_URL=http://localhost:8001/mcp
MCP_TIMEOUT_SECONDS=15
# Both processes must use the same value when the MCP server is exposed beyond localhost.
MCP_AUTH_TOKEN=
MCP_SERVER_AUTH_TOKEN=

# trigger.dev (background jobs)
TRIGGER_SECRET_KEY=

# Observability
SENTRY_DSN=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
OTEL_EXPORTER_OTLP_ENDPOINT=

# Frontend (Next.js)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
