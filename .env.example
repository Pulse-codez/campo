# Copy to .env and fill in. Never commit real secrets.

# Backend (FastAPI)
APP_ENV=development
DATABASE_URL=postgresql+asyncpg://campus:campus@localhost:5432/campus_support
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=change-me
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=14
FIELD_ENCRYPTION_KEY=

# Conversation model (TheraBot, confirm endpoints with vendor before use)
THERABOT_API_BASE_URL=
THERABOT_API_KEY=
THERABOT_TIMEOUT_SECONDS=15

# Speech (ElevenLabs)
ELEVENLABS_API_KEY=
ELEVENLABS_CRISIS_VOICE_ID=

# MCP policy and tool server
MCP_SERVER_URL=http://localhost:8001/mcp

# trigger.dev (background jobs)
TRIGGER_SECRET_KEY=

# Observability
SENTRY_DSN=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
OTEL_EXPORTER_OTLP_ENDPOINT=

# Frontend (Next.js)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
